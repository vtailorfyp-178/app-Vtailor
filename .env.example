# Copy this file to .env in the same folder (Folder\.env), then fill in real values.
# Do NOT commit .env — it is in .gitignore.

# Required — app will not start without these five
JWT_SECRET_KEY=change-me-to-a-long-random-secret
MONGODB_URL=mongodb://localhost:27017
MONGO_DB_NAME=vtailor_db
STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_SECRET=secret-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# OPENAI_API_KEY=
# STREAM CHAT (optional — chat works in demo mode without these)
# Get keys from https://dashboard.getstream.io/
# STREAM_API_KEY=
# STREAM_API_SECRET=
