# Copy to models-service/.env

MODELS_API_PORT=3001
MODEL_ROOT_PATH=../3d model

# Cloudinary (required for upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_FOLDER=vtailor-models

UPLOAD_DELAY_MS=1500
UPLOAD_MAX_RETRIES=2
UPLOAD_BATCH_SIZE=1
# Cloudinary free = 10MB max per file; skip 30MB original/ folder
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_SKIP_ORIGINAL=true
UPLOAD_SKIP_OPTIMIZED_IF_MOBILE=true

# MongoDB — IMPORTANT:
# Do NOT set localhost here if you use MongoDB Atlas in app-Vtailor\.env
# Leave these commented; parent ../.env is loaded automatically:
# MONGODB_URL=mongodb://localhost:27017
# MONGO_DB_NAME=vtailor
#
# Or paste the same Atlas URL as app-Vtailor\.env:
# MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/
# MONGO_DB_NAME=app_vtailor_db

# Upload without Mongo (JSON only): npm run upload:glbs -- --skip-mongo
# SKIP_MONGODB=true
